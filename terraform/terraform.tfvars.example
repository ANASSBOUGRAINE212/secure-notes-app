# MiniStack
ministack_endpoint    = "http://localhost:4566"
ministack_access_key  = "test"
ministack_secret_key  = "test"
region                = "us-east-1"

# Names and network
project_name      = "secure-notes"
environment       = "local"
vpc_cidr           = "10.0.0.0/16"
availability_zone  = "us-east-1a"

# Keeping SSH access limited to your IP range is safer.
allowed_ssh_cidr = "0.0.0.0/0"

# Starting with one control plane and two workers.
kubernetes_control_plane_count = 1
kubernetes_node_count          = 2

# Choosing an AMI that exists in your MiniStack setup.
instance_ami = "ami-0c55b159cbfafe1f0"

control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.small"
control_plane_volume_size   = 30
worker_volume_size          = 20

# Adding your public key here; keeping the private key on your computer.
ssh_public_key = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY_CONTENT"
