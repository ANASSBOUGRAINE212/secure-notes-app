# Copy to repo-secret.yaml, set a GitLab username and a token with read_repository access.
# Keep repo-secret.yaml out of Git. Its URL must match argocd/application.yaml exactly.
apiVersion: v1
kind: Secret
metadata:
  name: secure-notes-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: http://192.168.182.138/root/secure-notes.git
  username: YOUR_GITLAB_USERNAME
  password: YOUR_GITLAB_ACCESS_TOKEN
