# Copy to repo-secret.yaml and replace the placeholders locally.
# Keep repo-secret.yaml out of Git.
apiVersion: v1
kind: Secret
metadata:
  name: secure-notes-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/OWNER/REPOSITORY.git
  username: YOUR_GITHUB_USERNAME
  password: YOUR_PERSONAL_ACCESS_TOKEN
