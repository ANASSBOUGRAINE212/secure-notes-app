# GitLab credentials Argo CD uses to read the private repository.
apiVersion: v1
kind: Secret
metadata:
  name: secure-notes-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://gitlab.com/anassbougraine644/secure-notes.git
  username: YOUR_GITLAB_USERNAME
  password: YOUR_GITLAB_ACCESS_TOKEN
