# auth-service's own database
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db

# notes-service's own database
NOTES_DB_USER=notes_user
NOTES_DB_PASSWORD=notes_pass
NOTES_DB_NAME=notes_db

# MUST be identical for auth-service and notes-service - one signs
# tokens, the other verifies them, using this same secret.
JWT_SECRET=replace-me-with-something-random-and-long
